{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "tools"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/tool"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "git"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "go"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "gofmt"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "staticcheck"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "gosec"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "govulncheck"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "gitleaks"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "actionlint"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "sonar-scanner"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        }
      ]
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9]+$"
    },
    "helpers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/helper"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ruleset_sha256"
      ],
      "properties": {
        "ruleset_sha256": {
          "$ref": "#/$defs/digest"
        },
        "server_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "allOf": [
            {
              "not": {
                "pattern": "[^\\x20-\\x7e]"
              }
            },
            {
              "pattern": "[^ ]"
            }
          ]
        },
        "active_rules_sha256": {
          "$ref": "#/$defs/digest"
        },
        "profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "gate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "embedded",
            "file",
            "vulndb_snapshot",
            "sonar_remote"
          ]
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "version",
        "version_output_sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "git",
            "go",
            "gofmt",
            "staticcheck",
            "gosec",
            "govulncheck",
            "gitleaks",
            "actionlint",
            "sonar-scanner"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:/[^/\\x00-\\x1f\\x7f].*|[A-Za-z]:[\\\\/][^\\x00-\\x1f\\x7f].*)$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "allOf": [
            {
              "not": {
                "pattern": "[^\\x20-\\x7e]"
              }
            },
            {
              "pattern": "[^ ]"
            }
          ]
        },
        "version_output_sha256": {
          "$ref": "#/$defs/digest"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "git",
                  "go",
                  "gofmt"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "rules"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "staticcheck",
                  "gosec",
                  "govulncheck",
                  "gitleaks",
                  "actionlint",
                  "sonar-scanner"
                ]
              }
            }
          },
          "then": {
            "required": [
              "rules"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "staticcheck",
                  "gosec",
                  "govulncheck",
                  "gitleaks",
                  "actionlint"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "server_version"
                      ]
                    },
                    {
                      "required": [
                        "active_rules_sha256"
                      ]
                    },
                    {
                      "required": [
                        "profile_sha256"
                      ]
                    },
                    {
                      "required": [
                        "gate_sha256"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "sonar-scanner"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "required": [
                  "ruleset_sha256",
                  "server_version",
                  "active_rules_sha256",
                  "profile_sha256",
                  "gate_sha256"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "staticcheck"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "embedded"
                  }
                },
                "not": {
                  "required": [
                    "input"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "gosec"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "embedded"
                  }
                },
                "not": {
                  "required": [
                    "input"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "actionlint"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "embedded"
                  }
                },
                "not": {
                  "required": [
                    "input"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "gitleaks"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "file"
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "govulncheck"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "vulndb_snapshot"
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "sonar-scanner"
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "properties": {
                  "kind": {
                    "const": "sonar_remote"
                  }
                },
                "not": {
                  "required": [
                    "input"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:/[^/\\x00-\\x1f\\x7f].*|[A-Za-z]:[\\\\/][^\\x00-\\x1f\\x7f].*)$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "ssh-keygen"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:/[^/\\x00-\\x1f\\x7f].*|[A-Za-z]:[\\\\/][^\\x00-\\x1f\\x7f].*)$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "$comment": "Structural portable v1 declaration. The strict JSON decoder additionally requires lexical integer version 1, UTF-8 paths of at most 4096 bytes, and unique case-folded tool IDs. Native loading validates local platform, protected regular-file metadata, canonical paths, disjoint source/output locations and digests. Profile requirements are enforced by the runner."
}
