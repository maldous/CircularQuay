{
  "version": 1,
  "sources": {
    "service-sops": {
      "type": "sops",
      "path": "repo:secrets/reference-api.sops.json",
      "sops": "/usr/bin/sops",
      "age_identity_file": "/etc/circularquay/identities/reference-age.txt",
      "identity": "none"
    }
  },
  "workloads": {
    "reference-api": {
      "mode": "hybrid",
      "bindings": [
        {
          "name": "API_TOKEN",
          "source": "service-sops",
          "field": "api_token",
          "allow_offline": true,
          "allow_publish": true
        }
      ],
      "environment": {
        "APP_MODE": "production"
      },
      "directory": "/var/lib/reference-api",
      "snapshot": {
        "path": "/var/lib/circularquay/snapshots/reference-api.sops.json",
        "recipients": [
          "age1cy0su9fwf3gf9mw868g5yut09p6nytfmmnktexz2ya5uqg9vl9sss4euqm"
        ],
        "identity_file": "/etc/circularquay/identities/reference-age.txt",
        "sops": "/usr/bin/sops"
      },
      "targets": {
        "systemd-credential": {
          "type": "systemd",
          "path": "/etc/credstore.encrypted/reference-api",
          "accept_snapshot": true,
          "service": "reference-api.service",
          "activation": "restart"
        }
      }
    }
  },
  "grants": [
    {
      "subject": "https://id.example.test|reference-operator-001",
      "client": "reference-console",
      "workload": "reference-api",
      "operations": [
        "list",
        "status"
      ],
      "authority": "workforce"
    }
  ],
  "mcp": {
    "address": "127.0.0.1:8787",
    "origins": [
      "https://console.example.test"
    ],
    "hosts": [
      "mcp.example.test"
    ],
    "audit_path": "/var/lib/circularquay/audit/reference-api.jsonl",
    "resource": "https://mcp.example.test/mcp",
    "authorities": {
      "workforce": {
        "issuer": "https://id.example.test",
        "jwks_url": "https://id.example.test/.well-known/jwks.json",
        "audience": "registered-cquay-api",
        "profile": "rfc9068",
        "clients": [
          "reference-console"
        ],
        "subjects": [
          "https://id.example.test|reference-operator-001"
        ],
        "required_scopes": [
          "session:approved"
        ],
        "permissions": {
          "list": {
            "scopes": [
              "workloads:discover"
            ]
          },
          "status": {
            "scopes": [
              "workloads:status"
            ]
          }
        }
      }
    }
  },
  "repository": {
    "url": "https://github.com/example-org/cquay-config.git",
    "directory": "/var/lib/circularquay/repository",
    "ref": "refs/heads/main",
    "allowed_signers_file": "/etc/circularquay/repository-signers",
    "initial_commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}
