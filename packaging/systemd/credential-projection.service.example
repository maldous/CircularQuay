[Unit]
Description=Example application using a native systemd encrypted projection
After=local-fs.target

[Service]
Type=simple
User=example-app
Group=example-app
LoadCredentialEncrypted=workload.json:/etc/credstore.encrypted/example-app.json
ExecStart=/opt/example/bin/application --config %d/workload.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# This is an offline/deployed snapshot interface, not per-launch online audit.
# Projection changes require a fresh application invocation. systemd-creds
# ciphertext is host-bound and cannot replace canonical SOPS recovery material.
