[Unit]
Description=CircularQuay enrolled workload %i
After=local-fs.target

[Service]
Type=simple
User=cquay-%i
Group=cquay-%i
UMask=0077
ExecStart=/usr/local/bin/cquay --config /etc/circularquay/%i.json --state-dir /var/lib/cquay-%i run --workload %i
StateDirectory=cquay-%i
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cquay-%i

# Online mode resolves again on EVERY ExecStart, including crash restarts. Do
# not replace this with a dependency oneshot that stays successful indefinitely.
# Offline/hybrid enrollment must seed and verify a scoped encrypted snapshot.
